import numpy as np
import matplotlib as mpl
mpl.use('Agg')
import matplotlib.pyplot as plt
import sys, os
from scipy.optimize import curve_fit
from matplotlib.colors import LinearSegmentedColormap
import random
from sklearn.metrics import r2_score

def main():
    usage = "Usage: " + sys.argv[0] + " <asymmetry values> <n> <L>"
    if len(sys.argv) != 4:
        print(usage)
        exit()

    data_file = sys.argv[1]
    n_input = sys.argv[2]
    L_input = sys.argv[3]
    
    data = read_data(data_file)
    for n in data:
        for L in data[n]:
            #if n == n_input and int(L) > 2 and int(L) < 10:
            if n == n_input and L == L_input:
                labels,asyms,balances,skews,lengths,dGs = zip(*data[n][L])
                data1,data2 = get_coeff(labels)
                asyms = np.array(asyms)
                balances = np.array(balances)
                skews = np.array(skews)
                lengths = np.array(lengths)
                x_values = (asyms,balances,skews,data1,data2)
                y_values = np.array(dGs)
                #print(n,L,len(y_values),len(asyms))
                popt,pcov = curve_fit(f,x_values,y_values)
                #print(popt)
                y_pred = f(x_values,*popt)
                (A,B,C,D,E,F) = popt
                equ_label = r'$\Delta G_{fit} = $'+str(round(A,2))+'*A + ' + str(round(B,2)) + '*H + ' + str(round(C,2)) + '*S + ' + str(round(D,2)) + '*P[(n-1)/2] + ' + str(round(E,2)) + '*P[n-1] + ' + str(round(F,2))
                #equ_label = ""
                plt.scatter(y_values,y_pred,label=f"n={n} L={L}\n" + equ_label)
                R2 = r2_score(y_pred,y_values)                
                for label,aa,b,s,P1,P2,dG,dG_fit in zip(labels,asyms,balances,skews,data1,data2,dGs,y_pred):
                    print("%s\t%.2f\t%.2f\t%.2f\t%.3f\t%.3f\t%.3f\t%.3f" % (label,aa,b,s,P1,P2,dG,dG_fit))
                print(popt)
                print("R^2 =",R2)

    plt.legend(fontsize=9)
    plt.xlabel('paperloops ' + r'$\Delta G$')
    plt.ylabel('linear fit ' + r'$\Delta G_{fit}$')
    plt.savefig('test.pdf')

#############
# FUNCTIONS #
#############
 
def get_coeff(labels):
    data1 = []
    data2 = []
    for label in labels:
        lengths = [float(this_L) for this_L in label.split('-') ]
        fc = np.fft.fft(lengths)
        fc2 = np.abs(fc)**2
        fc2 = fc2 / np.sum(fc2)
        P1 = fc2[int((len(fc2)-1)/2)]
        P2 = fc2[len(fc2)-1]
        data1.append(float(P1))
        data2.append(float(P2))
    return np.array(data1),np.array(data2)
    
def f(x,A,B,C,D,E,F):
    asym,H,skew,P1,P2 = x
    #return A*asym + B*balance + C*skew + D*length + E
    return  A*asym + B*H  + C*skew + D*P1 + E*P2 + F

def read_data(data_file):
    F = open(data_file)
    data = {}
    for line in F:
        n,L,label,asym,balance,skew,dG = line.strip().split('\t')
        if n not in data:
            data[n] = {}
        if L not in data[n]:
            data[n][L] = []
        data[n][L].append((label,float(asym),float(balance),float(skew),int(L),float(dG)))
    return data

main()
