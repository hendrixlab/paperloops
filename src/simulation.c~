	double w = 1.0;
	if(v != 0.0) {
	  double sqrt_w = sin(v/2)/(v/2);
	  w = sqrt_w*sqrt_w; // more efficient than pow()
	}
	double C_eff = p/(w/(8.0*pi*pi))/(6.022e23/1.0e27);
	double den = (w/(8.0*pi*pi))/(6.022e23/1.0e27);
	array_set(temp_samples,N_count,C_eff);
	N_count++;
      }
    }
  }
  if(N_count == 0) {
